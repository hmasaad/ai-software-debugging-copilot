# OpenAI-compatible API (OpenAI, Azure, Groq, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Anthropic (used when ANTHROPIC_API_KEY is set and OPENAI_API_KEY is not)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Cursor SDK agent mode (full engineer loop in the repo)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
