{
  "name": "debugging-copilot",
  "version": "0.1.0",
  "description": "An AI debugging copilot that investigates bugs like an engineer: collect evidence, identify root cause, propose a fix, and verify it.",
  "type": "module",
  "bin": {
    "debug-copilot": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "debug:example": "tsx src/cli.ts --repo examples/failing-cart --log examples/failing-cart/crash.log --investigator heuristic --no-run-tests",
    "board:example": "tsx src/cli.ts --repo examples/failing-cart --log examples/failing-cart/crash.log --investigator heuristic --json examples/failing-cart/debug-report.json --board --port 8787"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "debugging",
    "root-cause-analysis",
    "ai",
    "copilot",
    "observability"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
